@startuml Use Case Diagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecaseFontSize 11
skinparam actorFontSize 11

title Sneakers E-Commerce — Use Case Diagram (Verified Codebase)

rectangle "Sneakers Odoo Module" {

  usecase "Parcourir le catalogue" as UC1
  usecase "Consulter un produit" as UC2
  usecase "Ajouter au panier" as UC3
  usecase "Gérer le panier" as UC4
  usecase "Passer commande" as UC5
  usecase "Choisir moyen de paiement" as UC6
  usecase "Voir confirmation" as UC7

  usecase "Ajouter/Retirer\nla liste de souhaits" as UC8
  usecase "Consulter la\nliste de souhaits" as UC9

  usecase "S'inscrire à la\nnewsletter" as UC10
  usecase "Partager sur\nréseaux sociaux" as UC11

  usecase "Consulter FAQ /\nCGV / Contact" as UC12

  usecase "Gérer les\ncarrières d'envoi" as UC13
  usecase "Tester SendCloud" as UC14
  usecase "Importer méthodes\nd'envoi" as UC15

  usecase "Gérer les\ncampagnes newsletter" as UC16
  usecase "Publier un\npost social" as UC17
  usecase "Gérer les marques\n(product.brand)" as UC18
}

actor "Client" as Client
actor "Administrateur" as Admin

Client --> UC1
Client --> UC2
Client --> UC3
Client --> UC4
Client --> UC5
Client --> UC6
Client --> UC7
Client --> UC8
Client --> UC9
Client --> UC10
Client --> UC11
Client --> UC12

Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17
Admin --> UC18
Admin --> UC13
Admin --> UC1

UC5 ..> UC4 : <<include>>
UC7 ..> UC5 : <<include>>
UC6 ..> UC5 : <<include>>
UC14 ..> UC13 : <<include>>
UC15 ..> UC13 : <<include>>

@enduml
